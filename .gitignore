# 每轮抓取的原始 XML，可再生，且单轮 40MB —— 不提交
raw/

# 候选池快照。体积大（每轮 ~2.6MB），且判断结果与理由已记在
# data/seen.json（判断台账）和 weekly/*.md（周报）里，这里不必留档。
data/candidates_*.json

# 一次性诊断产物
data/candidates_*.run*.json

# 摘要 / 文献类型 / PMC 号缓存（~3MB），scripts/enrich.py 随时可重建
data/meta_cache.json

# 页面样稿，选定后并入 templates/，本身不提交
drafts/

# 判断层的中间结果（分批输入与回复，用于断点续跑），结论已写进 seen.json 与周报
work/

# run_weekly.sh 的运行日志与锁
logs/

# Python 字节码
__pycache__/
*.pyc
